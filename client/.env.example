# -------------------------------------------
# API DOMAIN (required)
# -------------------------------------------
# Your Cloudflare Workers API URL (without https://)
# 
# For workers.dev subdomain:
#   VITE_API_DOMAIN=finance-api.yourname.workers.dev
#
# For custom domain:
#   VITE_API_DOMAIN=api.finance.yourdomain.com
#
VITE_API_DOMAIN=localhost:8787

# Local development and public demos explicitly use public mode.
# For private production, the deploy CLI sets this to private.
VITE_API_AUTH_MODE=public
