{
  "name": "finance-manager",
  "version": "2.11",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "workspaces": [
    "client",
    "api",
    "mcp"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w api\"",
    "build": "npm run build -w client",
    "build:mcp": "npm run build -w mcp",
    "test:mcp": "npm run test -w mcp",
    "test": "npm test --workspaces && npm run test:deploy && npm run test:integration",
    "test:deploy": "node --test --test-reporter=spec scripts/deploy.test.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit -p api/tsconfig.json && tsc -b client && npm run build:mcp && tsc -p tests/integration/tsconfig.json",
    "deploy": "node scripts/deploy.mjs",
    "deploy:client": "node scripts/deploy.mjs client",
    "deploy:api": "node scripts/deploy.mjs api",
    "deploy:mcp": "node scripts/deploy.mjs mcp",
    "deploy:migrations": "node scripts/deploy.mjs migrations"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^24.13.6",
    "concurrently": "^8.2.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  },
  "dependencies": {
    "yahoo-finance2": "^3.10.2"
  }
}
