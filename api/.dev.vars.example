# Local development only. Do not use public mode with private financial data.
API_AUTH_MODE=public
ALLOWED_ORIGINS=http://localhost:5173

# Private production requires Cloudflare Access on the API custom hostname.
# Configure these in .deploy-config, not in the frontend.
# API_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# API_ACCESS_AUD=your-api-access-application-audience
# API_ACCESS_ALLOWED_EMAIL=you@example.com
