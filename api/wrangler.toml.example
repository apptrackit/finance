name = "finance-api"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]
main = "src/index.ts"

# Local development works with this disabled. Private production uses a custom domain.
workers_dev = false
preview_urls = false

# Custom domain route (optional - comment out if not using custom domain)
# routes = [
#   { pattern = "api.finance.yourdomain.com", custom_domain = true }
# ]

[define]
__dirname = "'/'"

[[d1_databases]]
binding = "DB"
database_name = "finance-db"
database_id = "YOUR-DATABASE-ID-HERE"  # Replace with your D1 database ID

[triggers]
crons = ["0 0 * * *"] # Run daily at midnight to process recurring schedules

# Authentication defaults to private. api/.dev.vars.example explicitly enables
# public mode for local development; never use that setting for private finances.
[vars]
API_AUTH_MODE = "private"
API_ACCESS_TEAM_DOMAIN = "https://your-team.cloudflareaccess.com"
API_ACCESS_AUD = "your-api-access-application-audience"
API_ACCESS_ALLOWED_EMAIL = "you@example.com"
ALLOWED_ORIGINS = "https://your-frontend-domain.com"
